{
  "name": "@bloomskill/table-engine",
  "version": "0.44.0",
  "description": "Headless React data-grid engine on TanStack Table v9 — sorting, filtering, pagination, grouping, inline editing, cell & row selection, clipboard, CSV/Excel export and virtualization. Pair with the MUI or shadcn skin, or stay fully headless. TypeScript, MIT.",
  "keywords": [
    "react",
    "table",
    "data-grid",
    "datagrid",
    "data-table",
    "datatable",
    "grid",
    "react-table",
    "react-datatable",
    "tanstack",
    "tanstack-table",
    "headless",
    "headless-ui",
    "spreadsheet",
    "editable",
    "editable-grid",
    "inline-editing",
    "virtualization",
    "virtualized",
    "sorting",
    "filtering",
    "pagination",
    "grouping",
    "csv",
    "excel",
    "export",
    "clipboard",
    "server-side",
    "datasource",
    "typescript",
    "bst-table"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitOfKumarSathish/bst-grid.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/gitOfKumarSathish/bst-grid/tree/main/packages/engine#readme",
  "bugs": "https://github.com/gitOfKumarSathish/bst-grid/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/bst-table.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.13.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  }
}
