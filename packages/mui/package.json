{
  "name": "@bloomskill/table-mui",
  "version": "0.47.0",
  "description": "Material UI (MUI) React data grid — a drop-in BstTableMui component with sorting, filtering, pagination, inline editing, selection, clipboard and CSV/Excel export; reads your MUI theme (light & dark). Built on the headless @bloomskill/table-engine. TypeScript, MIT.",
  "keywords": [
    "react",
    "table",
    "data-grid",
    "datagrid",
    "data-table",
    "datatable",
    "grid",
    "mui",
    "material-ui",
    "material",
    "react-table",
    "tanstack-table",
    "editable",
    "editable-grid",
    "inline-editing",
    "sorting",
    "filtering",
    "pagination",
    "export",
    "csv",
    "excel",
    "typescript",
    "bst-table"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitOfKumarSathish/bst-grid.git",
    "directory": "packages/mui"
  },
  "homepage": "https://github.com/gitOfKumarSathish/bst-grid/tree/main/packages/mui#readme",
  "bugs": "https://github.com/gitOfKumarSathish/bst-grid/issues",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@bloomskill/table-engine": "^0.47.0",
    "@mui/material": ">=6",
    "@mui/icons-material": ">=6",
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11"
  },
  "devDependencies": {
    "@bloomskill/table-engine": "^0.47.0",
    "@mui/material": "^9.3.1",
    "@mui/icons-material": "^9.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@tanstack/react-table": "^9.1.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
