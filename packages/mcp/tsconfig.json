{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    // Node-only package (a CLI + a build-time generator), unlike the browser
    // packages: NodeNext resolution so the emitted ESM runs under plain `node`
    // and relative imports are forced to carry their `.js` extension.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/__tests__/**"]
}
